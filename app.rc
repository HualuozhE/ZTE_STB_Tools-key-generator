    PUSHBUTTON      "一键算号",IDC_GO,7,40,86,24
    LTEXT           "同时生成两个已知版本的注册码：",IDC_STATIC,102,46,150,10,0,WS_EX_TRANSPARENT
    LTEXT           "注册码（2.1.1 / 8.1.1 通用）：",IDC_STATIC,7,74,120,10,0,WS_EX_TRANSPARENT
